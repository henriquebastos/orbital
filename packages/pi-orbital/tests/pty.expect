set timeout 2
spawn -noecho $env(ORBITAL_PI_BIN) --offline --no-extensions --no-skills --no-prompt-templates --no-themes --no-context-files --no-approve --extension $env(ORBITAL_PI_EXTENSION) --provider orbital-fixture --model probe --tools orbital,bash,read --session $env(ORBITAL_PI_SESSION)
send_user "__PTY_CHILD_PID__[exp_pid]\n"

expect {
  -re {Orbital fixture|Type your message|Press Enter} {}
  timeout {}
  eof { exit 2 }
}
set timeout 12
send -- "Create the orb and run the marker command.\r"
expect {
  -re {PTY_OUT_REMOTE_PTY} {}
  timeout { send -- "\003"; exit 3 }
  eof { exit 4 }
}
expect {
  -re {FIXTURE_DONE} { send_user "__FIRST_REMOTE_OUTPUT__\n" }
  timeout { send -- "\003"; exit 8 }
  eof { exit 9 }
}
send -- "Read the marker from the same orb.\r"
expect {
  -re {FIXTURE_DONE} { send_user "__FOLLOWUP_TURN_DONE__\n" }
  timeout { send -- "\003"; exit 5 }
  eof { exit 6 }
}
send -- "\004"
expect {
  eof {}
  timeout { send -- "\003"; exit 7 }
}
set result [wait]
exit [lindex $result 3]
