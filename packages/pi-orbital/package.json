{
  "name": "@henriquebastosnet/pi-orbital",
  "version": "0.1.0",
  "description": "Use Orbital workspaces from Pi sessions.",
  "license": "MIT",
  "author": "Henrique Bastos",
  "repository": { "type": "git", "url": "git+https://github.com/henriquebastos/orbital.git", "directory": "packages/pi-orbital" },
  "homepage": "https://github.com/henriquebastos/orbital/tree/main/packages/pi-orbital#readme",
  "bugs": { "url": "https://github.com/henriquebastos/orbital/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "pi": { "extensions": ["./src/index.ts"] },
  "keywords": ["pi-package"],
  "files": ["src", "dist"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@henriquebastosnet/orbital": "0.1.0",
    "typebox": "1.3.27"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true } }
}
